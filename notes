from genlayer import *

class OnchainNotes(gl.Contract):
    notes: DynArray[str]

    def __init__(self):
        self.notes = []

    @gl.public.write
    def add_note(self, text: str) -> None:
        self.notes.append(text)

    @gl.public.write
    def delete_last_note(self) -> None:
        if len(self.notes) > 0:
            self.notes.pop()

    @gl.public.view
    def get_notes(self) -> DynArray[str]:
        return self.notes

    @gl.public.view
    def get_count(self) -> u256:
        return u256(len(self.notes))
